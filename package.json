{
  "name": "gasho",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/protocol && tsc -p packages/plugin-sdk && tsc -p apps/daemon && tsc -p apps/hub && tsc -p scripts && npm run typecheck -w @gasho/web",
    "test": "npm run test -w @gasho/web && node --test --disable-warning=ExperimentalWarning \"apps/*/test/*.test.ts\" \"scripts/*.test.ts\"",
    "test:coverage": "node --test --disable-warning=ExperimentalWarning --experimental-test-coverage --test-coverage-include=\"apps/*/src/**\" --test-coverage-include=\"packages/*/src/**\" --test-coverage-include=\"packages/*/scripts/**\" --test-coverage-include=\"scripts/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" \"apps/*/test/*.test.ts\" \"scripts/*.test.ts\"",
    "hub": "npm run start -w @gasho/hub",
    "hub:pair": "npm run pair -w @gasho/hub",
    "hub:devices": "npm run devices -w @gasho/hub",
    "hub:plugin": "npm run plugin -w @gasho/hub --",
    "daemon": "npm run start -w @gasho/daemon",
    "web:dev": "npm run dev -w @gasho/web",
    "web:build": "npm run build -w @gasho/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
